rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Authenticated users can read/write their own user doc and health data
    match /users/{userId} {
      allow read, write: if request.auth != null;
      match /{allChildren=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Circles collection for friends & accountability
    match /circles/{circleId} {
      allow read, write: if request.auth != null;
      match /{allChildren=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Nudges collection for friend reminders
    match /nudges/{nudgeId} {
      allow read, write: if request.auth != null;
    }

    // Notification queue for FCM
    match /notification_queue/{queueId} {
      allow read, write: if request.auth != null;
    }
  }
}
